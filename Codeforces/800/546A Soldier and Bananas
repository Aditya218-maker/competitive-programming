#include <iostream>
using namespace std;

int main() {
    long long k, n, w;
    cin >> k >> n >> w;

    long long sum = 0;
    long long i = 1;

    while (w--) {
        sum += i * k;
        i++;
    }

    long long borrow = sum - n;
    if (borrow < 0) borrow = 0;

    cout << borrow << endl;
    return 0;
}
