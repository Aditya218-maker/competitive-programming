#include <iostream>
#include <unordered_map>
using namespace std;
 
int main() {
    unordered_map<string, int> faces = {
        {"Tetrahedron", 4},
        {"Cube", 6},
        {"Octahedron", 8},
        {"Dodecahedron", 12},
        {"Icosahedron", 20}
    };
 
    int n;
    cin >> n;
 
    int sum = 0;
    while (n--) {
        string s;
        cin >> s;
        sum += faces[s];
    }
 
    cout << sum << endl;
 
    return 0;
}
